# PUBG Scoreboard — Apache / XAMPP front controller.
# (The standalone server `php server.php` does not use this file.)

Options -Indexes +FollowSymLinks
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Works both at a domain root and in a subfolder such as /PUBGScoreboard/ —
    # no RewriteBase needed because every rule is relative to this folder.

    # Source code, tests, templates and private data are not for browsers.
    RewriteRule ^(Engine|Views|tests|runtime|\.git|\.github)(/|$) - [F,L]
    RewriteRule ^Autoload/(backups(/|$)|server\.php$|tournament_data\.json$|\.lock$) - [F,L]
    RewriteRule ^(server\.php|about\.json|.*\.(bat|sh|md))$ - [F,L]

    # Pass the Authorization header through to PHP.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Everything that is not a real file goes to index.php (/, /scoreboard, /api/...).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    # Without mod_rewrite, unknown URLs fall back to the front controller.
    ErrorDocument 404 index.php
</IfModule>

# Uploaded images are content-addressed: cache them for good.
<IfModule mod_headers.c>
    <FilesMatch "^[a-f0-9]{16,64}\.(png|jpg|gif|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js|json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
